# Auth.js
AUTH_SECRET=
# Production only — omit locally; Auth.js uses the request host (works on any dev port).
# AUTH_URL=https://your-domain.com

# Google OAuth
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Resend (magic link)
AUTH_RESEND_KEY=

# Supabase (Auth.js adapter)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# App
NEXT_PUBLIC_API_URL=

# Shared HS256 secret for /api/upload-token — must match the FastAPI verifier.
UPLOAD_TOKEN_SECRET=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Stripe products (test)
STRIPE_PRODUCT_CREATOR=
STRIPE_PRODUCT_STUDIO=
STRIPE_PRODUCT_FOUNDING_T1=
STRIPE_PRODUCT_FOUNDING_T2=

# Stripe prices (test)
STRIPE_PRICE_CREATOR_MONTHLY=
STRIPE_PRICE_CREATOR_YEARLY=
STRIPE_PRICE_STUDIO_MONTHLY=
STRIPE_PRICE_STUDIO_YEARLY=
STRIPE_PRICE_FOUNDING_T1=
STRIPE_PRICE_FOUNDING_T2=

# B2C queue only; audio stays on the Mac Mini.
PODMASTER_QUEUE_BACKEND=legacy
# Paid input transport: off (default), canary, or on. Keep the shared queue on Supabase.
PODMASTER_PAID_UPLOADS=off
PODMASTER_PAID_UPLOAD_TEST_USERS=
# Secret used only by the scheduled private Storage input cleaner.
CRON_SECRET=
